{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "backend: build",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/bobweb/bobweb.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "backend: wait for ready",
            "type": "shell",
            "command": "for attempt in $(seq 1 60); do if (echo > /dev/tcp/127.0.0.1/5080) >/dev/null 2>&1; then exit 0; fi; sleep 1; done; echo \"bobweb did not become ready on http://127.0.0.1:5080 within 60 seconds.\" >&2; exit 1",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "/bin/bash",
                    "args": [
                        "-lc"
                    ]
                }
            },
            "presentation": {
                "reveal": "silent"
            },
            "problemMatcher": []
        },
        {
            "label": "frontend: wait for Live Server",
            "type": "shell",
            "command": "for attempt in $(seq 1 30); do if (echo > /dev/tcp/127.0.0.1/5500) >/dev/null 2>&1; then exit 0; fi; sleep 1; done; echo \"Live Server is not responding on http://127.0.0.1:5500. Start Live Server for bobstatic/index.html in VS Code and try again.\" >&2; exit 1",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "/bin/bash",
                    "args": [
                        "-lc"
                    ]
                }
            },
            "presentation": {
                "reveal": "always"
            },
            "problemMatcher": []
        },
        {
            "label": "frontend: prepare browser launch",
            "dependsOn": [
                "backend: wait for ready",
                "frontend: wait for Live Server"
            ],
            "dependsOrder": "parallel"
        }
    ]
}
